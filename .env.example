SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Путь к npm для django-tailwind; по умолчанию npm ищется в PATH
# NPM_BIN_PATH=C:\Program Files\nodejs\npm.cmd

# --- Исходящая почта (этап 6) ---
# Если EMAIL_HOST НЕ задан, используется console backend: письма выводятся
# в консоль и дублируются в logs/mail.log — так удобно разрабатывать.
# Для реальной отправки укажите SMTP-сервер и параметры ниже.
# Отправка выполняется командой send_order_emails (см. send_emails.bat),
# очередь и её статусы видны в админке.
#
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=465
# EMAIL_HOST_USER=shop@example.com
# EMAIL_HOST_PASSWORD=secret_smtp_password
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# EMAIL_TIMEOUT=15
# Свой файл корневых сертификатов для проверки TLS SMTP (необязательно;
# по умолчанию используется набор certifi — нужен для серверов вроде
# smtp.mail.ru, чьи корни могут отсутствовать в системном хранилище Windows):
# EMAIL_CA_FILE=C:\path\to\cacert.pem
# Отправитель писем (имя и адрес «от кого»):
# DEFAULT_FROM_EMAIL=Ёлкин двор <shop@example.com>
